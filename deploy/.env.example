# Copy to deploy/.env (compose reads it) or export for `make run-api`. Defaults suit local development.
ROUTER_ENV=local
ROUTER_WORKSPACE_NAME=default
ROUTER_LOG_LEVEL=info
ROUTER_DATABASE_URL=postgres://router:router@localhost:5432/router?sslmode=disable
ROUTER_MIGRATE_ON_START=true
ROUTER_REDIS_URL=redis://localhost:6379/0
ROUTER_KAFKA_BOOTSTRAP=localhost:9092
ROUTER_PUBLIC_URL=http://localhost:8080
ROUTER_CURSOR_SECRET=local-dev-only-secret-change-me
ROUTER_COOKIE_SECRET=local-dev-only-secret-change-me
# Secure cookie flag; defaults to false in local, true elsewhere (false allowed in local/staging only).
# ROUTER_COOKIE_SECURE=

# Auth: comma list of oidc, dev (api_token in P2). dev is local-only.
ROUTER_AUTH_MODES=dev,oidc
ROUTER_AUTHZ=rbac
ROUTER_RBAC_ENGINE=rolebinding
ROUTER_RBAC_CACHE_TTL=30s
# Comma list of emails that become workspace admin on login; roles assignable in Settings (P2: all four)
ROUTER_BOOTSTRAP_ADMIN_EMAILS=
ROUTER_RBAC_ASSIGNABLE_ROLES=viewer,editor,approver,admin
ROUTER_SESSION_IDLE_TTL=8h
ROUTER_SESSION_ABSOLUTE_TTL=168h
ROUTER_DEV_ADMIN_EMAIL=admin@local.dev
ROUTER_DEV_TEAM_NAME=default
# OIDC (compose profile "oidc" starts Dex with these values)
ROUTER_OIDC_ISSUER=http://dex:5556/dex
ROUTER_OIDC_CLIENT_ID=event-router
ROUTER_OIDC_CLIENT_SECRET=event-router-dev-secret
ROUTER_OIDC_REDIRECT_URL=http://localhost:8080/auth/oidc/callback
ROUTER_OIDC_SCOPES=openid,email,profile

# Secrets: local key file (dev) or vault (production default)
ROUTER_SECRETS_PROVIDER=local
ROUTER_SECRETS_LOCAL_KEY_FILE=./.local/master.key
ROUTER_VAULT_ADDR=
ROUTER_VAULT_TOKEN=
ROUTER_VAULT_TRANSIT_KEY=event-router
ROUTER_VAULT_TRANSIT_MOUNT=transit

# Internal listener (api) and workload credentials (worker/preview)
ROUTER_INTERNAL_ADDR=:8443
ROUTER_WORKLOAD_AUTH=static_token
ROUTER_WORKLOAD_TOKEN=local-workload-token
ROUTER_CONTROL_PLANE_URL=http://localhost:8080
ROUTER_CONTROL_PLANE_INTERNAL_URL=http://localhost:8443

# Monitoring (metrics store for dashboard / route overview; `mock` serves deterministic series)
ROUTER_METRICS_BACKEND=prometheus
ROUTER_METRICS_URL=http://localhost:9090
ROUTER_METRICS_TIMEOUT=2s
# ROUTER_ROUTE_METRICS_READER=prometheus   # routes list columns from the metrics store (default null)
# ROUTER_MONITORING_ROUTE_LAG_WARN=2000
# ROUTER_MONITORING_ROUTE_LAG_ERROR=20000
# ROUTER_MONITORING_TOTAL_LAG_WARN=10000
# ROUTER_MONITORING_TOTAL_LAG_ERROR=40000
# ROUTER_MONITORING_ZERO_MATCH_WINDOW=30m
# ROUTER_MONITORING_LAG_GROWTH_WINDOW=15m
# ROUTER_MONITORING_ATTENTION_DETECTORS=route_error,lag_growing,connection_unhealthy,zero_match,alert_firing
# Alerts (monitoring P2): leader-only evaluator, channels email|slack|teams|webhook (default: all)
# ROUTER_ALERTS_ENABLED=true
# ROUTER_ALERTS_INTERVAL=30s
# ROUTER_ALERTS_CHANNELS=email,slack,teams,webhook
# ROUTER_ALERTS_MAX_ATTEMPTS=3
# ROUTER_ALERTS_HTTP_TIMEOUT=10s
# ROUTER_ALERTS_WEBHOOK_SIGNING_KEY=      # HMAC-SHA256 key → X-Router-Signature: sha256=hex(hmac(ts + "." + body))
# ROUTER_SMTP_HOST=
# ROUTER_SMTP_PORT=587
# ROUTER_SMTP_USER=
# ROUTER_SMTP_PASSWORD=
# ROUTER_SMTP_FROM=router@example.com
# Push events (WS /api/v1/events): bus redis|memory, visibility open|team
# ROUTER_EVENTS_BUS=redis
# ROUTER_EVENTS_VISIBILITY=open
# Live tail (P3, WS /api/v1/routes/{id}/tail): worker tap redis|noop (redis needs ROUTER_REDIS_URL on the worker),
# records per second per route copied while somebody watches.
# ROUTER_LIVETAIL_TAP=redis
# ROUTER_LIVETAIL_RATE=20

# Transform Studio assistant (cmd/api): provider kind (only "mock" ships), call timeout, per-user rate.
# ROUTER_ASSIST_PROVIDER=mock
# ROUTER_ASSIST_TIMEOUT=20s
# ROUTER_ASSIST_RATE_PER_MINUTE=30

# Route runtime: worker identity (stable pod name in k8s), placement zone, capacity score, on-disk config
# cache (assignments + version docs, never secrets), default DLQ connection (source|destination).
# ROUTER_WORKER_ID=worker-1
# ROUTER_WORKER_ZONE=default
# ROUTER_WORKER_CAPACITY=100
# ROUTER_WORKER_CACHE_DIR=/var/lib/router/cache
# ROUTER_DLQ_DEFAULT_TARGET=source
# ROUTER_WORKER_PRODUCER_SHARING=off
# Scheduler (leader-only, inside the api): placement strategy least_loaded|single_worker, opt-out per instance.
# ROUTER_SCHEDULER_PLACEMENT=least_loaded
# ROUTER_SCHEDULER_ENABLED=true

# --- platform-core P2 (defaults shown) ---
# ROUTER_RATE_LIMITER=redis
# ROUTER_RATE_LIMIT_PER_MINUTE=1200
# ROUTER_RATE_LIMIT_BURST=300
# ROUTER_TRACING_EXPORTER=none            # none | stdout | otlp
# ROUTER_TRACING_OTLP_ENDPOINT=localhost:4318
# ROUTER_TRACING_SAMPLE_RATIO=1
# ROUTER_WS_ALLOWED_ORIGINS=              # default: ROUTER_PUBLIC_URL
# ROUTER_WORKLOAD_MTLS_ALLOWED=           # mtls: allowed URI SAN / CN names
# ROUTER_CONTROL_PLANE_CLIENT_CERT_FILE=  # workers/preview with mtls
# ROUTER_CONTROL_PLANE_CLIENT_KEY_FILE=
# ROUTER_AWS_KMS_KEY_ID= ROUTER_AWS_KMS_REGION=us-east-1   # ROUTER_SECRETS_PROVIDER=aws_kms
# ROUTER_GCP_KMS_KEY_NAME=                # ROUTER_SECRETS_PROVIDER=gcp_kms
