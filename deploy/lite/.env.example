# Event Router LITE settings. Generate the real file with ./init.sh (random secrets, chmod 600); it never
# overwrites a key that already exists, so edit values here by hand. Values are read by docker compose:
# keep them unquoted and free of "$" (compose interpolates it; write "$$" for a literal dollar sign).
# Empty secret values below are filled by init.sh.

# --- compose ---------------------------------------------------------------------------------------------
# "metrics" also starts Prometheus (set the three metrics keys further down to match). Empty = core stack only.
COMPOSE_PROFILES=
# TLS in nginx itself (see README "Production mode"): uncomment and set WEB_TLS_CERT_FILE / WEB_TLS_KEY_FILE.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# WEB_TLS_CERT_FILE=/etc/letsencrypt/live/router.example.com/fullchain.pem
# WEB_TLS_KEY_FILE=/etc/letsencrypt/live/router.example.com/privkey.pem
# WEB_TLS_PORT=443

# --- mode ------------------------------------------------------------------------------------------------
# production: secure cookies + HTTPS in front are mandatory (guards refuse ROUTER_COOKIE_SECURE=false).
# HTTP trial (./init.sh --trial): ROUTER_ENV=staging + ROUTER_COOKIE_SECURE=false. Not for real data.
ROUTER_ENV=production
ROUTER_COOKIE_SECURE=true
# The URL people open (scheme + host [+ port]); also the allowed WebSocket origin and the base of alert links.
ROUTER_PUBLIC_URL=https://router.example.com
ROUTER_WORKSPACE_NAME=default
ROUTER_LOG_LEVEL=info

# --- host ports ------------------------------------------------------------------------------------------
# web is the only service on a non-loopback address; use WEB_BIND=127.0.0.1 behind a host-local TLS proxy.
WEB_BIND=0.0.0.0
WEB_PORT=8088
API_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PROMETHEUS_HOST_PORT=9090

# --- postgres / redis ------------------------------------------------------------------------------------
POSTGRES_USER=router
POSTGRES_DB=router
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# pool_max_conns of the api/preview DSN (postgres max_connections is 150).
ROUTER_DB_POOL_MAX_CONNS=16

# --- platform secrets (generated; changing them logs everyone out / breaks preview directives) ------------
ROUTER_CURSOR_SECRET=
ROUTER_COOKIE_SECRET=
ROUTER_PREVIEW_DIRECTIVE_SECRET=

# --- connection-credential encryption (static_key provider) ----------------------------------------------
# base64 of exactly 32 random bytes. BACK IT UP: without it saved connection credentials are unrecoverable.
# Set exactly one of ROUTER_SECRETS_MASTER_KEY or ROUTER_SECRETS_MASTER_KEY_FILE (path inside the api container).
ROUTER_SECRETS_MASTER_KEY=
ROUTER_SECRETS_MASTER_KEY_FILE=
# Rotation: comma-separated old keys, decrypt-only, until `docker compose exec api /app secrets rotate` finished.
ROUTER_SECRETS_PREVIOUS_MASTER_KEYS=

# --- login -----------------------------------------------------------------------------------------------
ROUTER_AUTH_MODES=password,api_token
# First start creates this admin with a forced password change. After that first login set the password
# value to empty (keep the key, or init.sh would generate a new one).
ROUTER_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ROUTER_BOOTSTRAP_ADMIN_PASSWORD=
# Alternative to the inline password: a file path inside the api container (mount it in an override file).
ROUTER_BOOTSTRAP_ADMIN_PASSWORD_FILE=
# Failed logins before an account is locked, and for how long.
ROUTER_LOGIN_MAX_FAILURES=5
ROUTER_LOGIN_LOCKOUT=15m
# Login attempts per minute per client IP (all accounts together).
ROUTER_LOGIN_IP_PER_MINUTE=20

# --- metrics (keep in line with COMPOSE_PROFILES) --------------------------------------------------------
# Without Prometheus the dashboard shows "Unavailable" cards and the route Overview tab a retry state; set
# the route-list reader to null, the evaluator off and drop the Prometheus-backed attention detectors.
# With COMPOSE_PROFILES=metrics: READER=prometheus, ALERTS_ENABLED=true, DETECTORS empty (= all).
ROUTER_METRICS_BACKEND=prometheus
ROUTER_METRICS_URL=http://prometheus:9090
ROUTER_ROUTE_METRICS_READER=null
ROUTER_ALERTS_ENABLED=false
ROUTER_MONITORING_ATTENTION_DETECTORS=route_error,connection_unhealthy,alert_firing
PROMETHEUS_RETENTION=7d

# --- alert delivery --------------------------------------------------------------------------------------
ROUTER_ALERTS_CHANNELS=slack,teams,webhook
# HMAC key of outgoing alert webhooks (generated).
ROUTER_ALERTS_WEBHOOK_SIGNING_KEY=
# Email alerts: add "email" to ROUTER_ALERTS_CHANNELS and fill the SMTP block.
ROUTER_SMTP_HOST=
ROUTER_SMTP_PORT=
ROUTER_SMTP_USER=
ROUTER_SMTP_PASSWORD=
ROUTER_SMTP_FROM=

# --- features --------------------------------------------------------------------------------------------
ROUTER_ASSIST_PROVIDER=mock
ROUTER_WORKER_ZONE=lite
