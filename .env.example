# Copy to .env and adjust. ROUTER_SERVICE is set by each binary; override only for testing.
ROUTER_ENV=local
ROUTER_LOG_LEVEL=info
# Leave empty to use per-service defaults (api :8080, worker :8081, preview :8082).
ROUTER_HTTP_ADDR=
ROUTER_HTTP_READ_HEADER_TIMEOUT=5s
ROUTER_HTTP_SHUTDOWN_TIMEOUT=15s
ROUTER_DATABASE_URL=postgres://router:router@localhost:5432/router?sslmode=disable
ROUTER_REDIS_URL=redis://localhost:6379/0
ROUTER_KAFKA_BOOTSTRAP=localhost:9092
ROUTER_SECRETS_PROVIDER=local
ROUTER_CONTROL_PLANE_URL=http://localhost:8080
