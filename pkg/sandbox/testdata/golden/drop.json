  "events": [
    {
      "key": null,
      "value": {
        "customer": "c-1"
      },
      "headers": {},
      "topic": "in",
      "partition": 0,
      "offset": 1,
      "timestamp": "2024-05-01T11:00:00Z"
    },
    {
      "key": null,
      "value": {
        "other": 1
      },
      "headers": {},
      "topic": "in",
      "partition": 0,
      "offset": 2,
      "timestamp": "2024-05-01T11:00:00Z"
    }
  ],
  "expect": [
    {
      "outputs": [
        {
          "value": {
            "customer": "c-1"
          }
        }
      ]
    },
    {
