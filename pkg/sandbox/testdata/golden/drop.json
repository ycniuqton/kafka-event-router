  "name": "drop events without a customer",
  "entry": "transform",
  "code": "function transform(event, ctx) {\n  if (!event.value.customer) {\n    ctx.log('dropping', event.offset);\n    return null;\n  }\n  return { value: event.value };\n}\n",
