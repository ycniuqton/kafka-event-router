{
  "name": "UI spec 8.5 example: order summary with masked email and frozen now",
  "entry": "transform",
  "code": "// Return the new event, null to drop it, or an array to emit several events.\nfunction transform(event, ctx) {\n  const { order } = event.value;\n  return {\n    ...event,\n    value: {\n      orderId: order.id,\n      total: order.items.reduce((sum, i) =\u003e sum + i.price * i.qty, 0),\n      email: ctx.mask.email(order.customer.email),\n      processedAt: ctx.now(),\n    },\n  };\n}\n",
