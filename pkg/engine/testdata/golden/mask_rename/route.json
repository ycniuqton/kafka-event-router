{
  "apiVersion": "router/v1",
  "name": "mask-rename",
  "source": { "connectionId": "c1", "topics": ["customers"], "format": { "type": "json" } },
  "branches": [{
    "id": "main",
    "transform": { "steps": [
      { "id": "r1", "kind": "rename", "from": "value.cust_id", "to": "value.customerId" },
      { "id": "m1", "kind": "mask", "field": "value.email", "style": "email" },
      { "id": "m2", "kind": "mask", "field": "value.card", "style": "last4" },
      { "id": "m3", "kind": "mask", "field": "value.pin", "style": "full" }
    ] },
    "destination": { "connectionId": "c1", "topic": "customers-public" }
  }]
}
