      "title": "RedactPreset",
      "type": "string",
      "enum": [
        "credit_card",
        "phone",
        "email",
        "iban"
      ]
    },
    "dateLayout": {
      "title": "DateLayout",
      "type": "string",
      "enum": [
        "rfc3339",
        "rfc3339_ms",
        "date",
        "datetime"
      ]
