      ]
    },
    "nodeType": {
      "title": "NodeType",
      "type": "string",
      "enum": [
        "and",
        "or",
        "not",
        "cond",
        "expr"
      ]
    },
    "opName": {
      "title": "OpName",
      "type": "string",
      "enum": [
        "eq",
